// ============================================================================
// Типы данных и вспомогательные функции
// ============================================================================

typedef unsigned long long int bigint; // 64-битное целое для больших чисел Фибоначчи

//-----------------------------------------------------------------------------
// Рекурсивное вычисление n-го числа Фибоначчи
// Примечание: Намеренно неоптимизировано для создания вычислительной нагрузки
//-----------------------------------------------------------------------------
bigint fibonacci(bigint n)
{
    // Базовые случаи: F(0) = 0, F(1) = 1
    return n < 2 ? n : fibonacci(n - 1) + fibonacci(n - 2);
}

//-----------------------------------------------------------------------------
// "Специальная" функция: вычисляет чётность суммы первых n чисел Фибоначчи
// Возвращает true, если сумма чётная, false - если нечётная
// Пример: n=5 → 0+1+1+2+3 = 7 → 7%2=1 → false
//-----------------------------------------------------------------------------
bool special(int n)
{
    bigint sum = 0;
    // Суммируем первые n чисел Фибоначчи: F(0), F(1), ..., F(n-1)
    for(int i = 0; i != n; i++)
        sum += fibonacci(i);
    
    // Проверяем чётность суммы
    return sum % 2 == 0;
}

// ============================================================================
// ПОДХОД 1: Последовательная обработка (базовый вариант для сравнения)
// ============================================================================

//-----------------------------------------------------------------------------
// Обработка всего массива в одном потоке
// Возвращает количество элементов, для которых special() вернула true
//-----------------------------------------------------------------------------
size_t single(const std::vector<int>& v)
{
    // std::count_if применяет предикат к каждому элементу и считает true
    return std::count_if(v.begin(), v.end(), [](const auto &el)
    {
        return special(el);
    });
}

// ============================================================================
// ПОДХОД 2: Блочное распределение (без общей разделяемой переменной)
// Каждый поток работает со своим сегментом массива и пишет в свою ячейку
// ============================================================================

//-----------------------------------------------------------------------------
// Параллельная обработка с разбиением массива на блоки
// n_threads - количество потоков для обработки
//-----------------------------------------------------------------------------
size_t block(const std::vector<int>& v, size_t n_threads)
{
    // Вектор для хранения результатов каждого потока
    // Каждый поток пишет в свою ячейку - нет конкуренции за доступ
    std::vector<size_t> results(n_threads, 0);
    
    // Лямбда-функция для выполнения в потоке
    // Параметры: a - начало диапазона, b - конец диапазона, thread_id - номер потока
    auto lambda = [&v, &results](size_t a, size_t b, size_t thread_id)
    {
        // Обрабатываем только свой сегмент массива [a, b)
        auto sum = std::count_if(v.begin() + a, v.begin() + b, [](const auto &el)
        {
            return special(el);
        });
        // Записываем результат в "свою" ячейку - безопасно без синхронизации
        results[thread_id] = sum;
    };

    // Создаём вектор для хранения объектов потоков
    std::vector<std::thread> threads(n_threads);
    
    // Вычисляем размер одного блока (приблизительно)
    size_t part_size = v.size() / n_threads;
    size_t a = 0, b = 0;
    
    // Запускаем потоки
    for(size_t t = 0; t != n_threads; t++, a = b)
    {
        // Последний поток обрабатывает все оставшиеся элементы
        b = (t == n_threads - 1) ? v.size() : a + part_size;
        
        // Создаём и запускаем поток с параметрами диапазона и ID
        threads[t] = std::thread(lambda, a, b, t);
    }

    // Ожидаем завершения всех потоков
    for(auto& t : threads)
        t.join();

    // Суммируем результаты всех потоков
    return std::accumulate(results.begin(), results.end(), 0ULL);
}

// ============================================================================
// ПОДХОД 3: Общий счётчик с mutex (ВАРИАНТ: this_is_the_way)
// Все потоки инкрементируют одну общую переменную под защитой мьютекса
// ============================================================================

//-----------------------------------------------------------------------------
// Параллельная обработка с использованием std::mutex для синхронизации
// Преимущества: простота реализации, гарантия корректности
// Недостатки: сериализация доступа к счётчику, возможные простои потоков
//-----------------------------------------------------------------------------
size_t this_is_the_way(const std::vector<int>& v, size_t n_threads)
{
    // Общий счётчик результатов - разделяемый ресурс между потоками
    size_t shared_counter = 0;
    
    // Мьютекс для защиты доступа к shared_counter
    // Только один поток может владеть мьютексом одновременно
    std::mutex counter_mutex;
    
    // Лямбда-функция для выполнения в потоке
    auto lambda = [&v, &shared_counter, &counter_mutex](size_t a, size_t b)
    {
        // Локальный счётчик для минимизации критических секций
        // Считаем результаты в локальной переменной, затем одним действием
        // обновляем общий счётчик - это уменьшает время удержания мьютекса
        size_t local_count = 0;
        
        // Обрабатываем свой сегмент массива
        for(size_t i = a; i < b; i++)
        {
            if(special(v[i]))
                local_count++;  // Инкремент локальной переменной - без синхронизации
        }
        
        // КРИТИЧЕСКАЯ СЕКЦИЯ: обновление общего счётчика
        // Блокируем мьютекс перед доступом к разделяемому ресурсу
        {
            std::lock_guard<std::mutex> lock(counter_mutex);
            // lock_guard автоматически захватывает мьютекс в конструкторе
            // и освобождает в деструкторе (при выходе из блока)
            // Это гарантирует освобождение мьютекса даже при исключении
            shared_counter += local_count;
        }
        // Мьютекс автоматически освобождается при выходе из области видимости lock
    };

    // Создаём и запускаем потоки
    std::vector<std::thread> threads(n_threads);
    size_t part_size = v.size() / n_threads;
    size_t a = 0, b = 0;
    
    for(size_t t = 0; t != n_threads; t++, a = b)
    {
        b = (t == n_threads - 1) ? v.size() : a + part_size;
        threads[t] = std::thread(lambda, a, b);
    }

    // Ожидаем завершения всех потоков
    for(auto& t : threads)
        t.join();

    // Возвращаем итоговый результат
    return shared_counter;
}

// ============================================================================
// ПОДХОД 4: Атомарный счётчик (ВАРИАНТ: is_this_the_way)
// Использование std::atomic для бесблокировочной синхронизации
// ============================================================================

//-----------------------------------------------------------------------------
// Параллельная обработка с использованием std::atomic для синхронизации
// Преимущества: часто быстрее мьютекса для простых операций, нет блокировок
// Недостатки: ограничен набором атомарных операций, возможна конкуренция на шине
//-----------------------------------------------------------------------------
size_t is_this_the_way(const std::vector<int>& v, size_t n_threads)
{
    // Атомарный счётчик - операции с ним выполняются неделимо
    // Аппаратная поддержка обеспечивает корректность без явных блокировок
    std::atomic<size_t> atomic_counter{0};
    
    // Лямбда-функция для выполнения в потоке
    auto lambda = [&v, &atomic_counter](size_t a, size_t b)
    {
        // Локальный счётчик для оптимизации (аналогично mutex-версии)
        size_t local_count = 0;
        
        // Обрабатываем свой сегмент массива
        for(size_t i = a; i < b; i++)
        {
            if(special(v[i]))
                local_count++;
        }
        
        // АТОМАРНОЕ обновление общего счётчика
        // fetch_add выполняет атомарное сложение и возвращает старое значение
        // Параметр memory_order_relaxed указывает, что не требуется
        // строгий порядок операций между потоками (максимальная производительность)
        // Для простого счётчика этого достаточно
        if(local_count > 0)  // Избегаем атомарной операции, если нечего добавлять
        {
            atomic_counter.fetch_add(local_count, std::memory_order_relaxed);
        }
    };

    // Создаём и запускаем потоки
    std::vector<std::thread> threads(n_threads);
    size_t part_size = v.size() / n_threads;
    size_t a = 0, b = 0;
    
    for(size_t t = 0; t != n_threads; t++, a = b)
    {
        b = (t == n_threads - 1) ? v.size() : a + part_size;
        threads[t] = std::thread(lambda, a, b);
    }

    // Ожидаем завершения всех потоков
    for(auto& t : threads)
        t.join();

    // Возвращаем значение атомарного счётчика (операция load по умолчанию)
    return atomic_counter.load();
}

// ============================================================================
// Вспомогательные функции для измерения и вывода статистики
// ============================================================================

//-----------------------------------------------------------------------------
// Структура для хранения результатов замера одного подхода
//-----------------------------------------------------------------------------
struct TimingResult {
    size_t threads;           // Количество потоков
    long long time_ms;        // Время выполнения в миллисекундах
    size_t result;            // Полученный результат (для проверки корректности)
    double speedup;           // Ускорение относительно single-threaded
    double efficiency;        // Эффективность использования потоков
};

//-----------------------------------------------------------------------------
// Функция для вывода заголовка таблицы результатов
//-----------------------------------------------------------------------------
void printHeader()
{
    cout << "\n" << string(80, '=') << "\n";
    cout << "РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ МНОГОПОТОЧНЫХ ПОДХОДОВ\n";
    cout << string(80, '=') << "\n";
    cout << left << setw(12) << "Подход" 
         << setw(10) << "Потоки" 
         << setw(12) << "Время(мс)" 
         << setw(12) << "Результат"
         << setw(12) << "Speedup"
         << setw(12) << "Efficiency" << "\n";
    cout << string(80, '-') << "\n";
}

//-----------------------------------------------------------------------------
// Функция для вывода строки результатов
//-----------------------------------------------------------------------------
void printResult(const string& method, const TimingResult& tr, long long single_time)
{
    // Вычисляем метрики, если известно время однопоточного выполнения
    if(single_time > 0)
    {
        const_cast<TimingResult&>(tr).speedup = static_cast<double>(single_time) / tr.time_ms;
        const_cast<TimingResult&>(tr).efficiency = tr.speedup / tr.threads;
    }
    
    cout << left << setw(12) << method
         << setw(10) << tr.threads
         << setw(12) << tr.time_ms
         << setw(12) << tr.result
         << fixed << setprecision(2)
         << setw(12) << tr.speedup
         << setw(12) << tr.efficiency << "\n";
}

// ============================================================================
// ОСНОВНАЯ ФУНКЦИЯ
// ============================================================================

int main()
{
    // Настройка локали для корректного вывода (опционально)
    // setlocale(LC_ALL, "Russian");
    
    cout << "=== САОД. Задание 9: Многопоточность ===" << endl;
    cout << "Вариант: mutex, atomic" << endl << endl;
    
    // ------------------------------------------------------------------------
    // 1. Генерация тестовых данных
    // ------------------------------------------------------------------------
    
    // Размер массива: для реального тестирования рекомендуется >= 50 элементов
    // Для отладки можно использовать меньшие значения
    const size_t ARRAY_SIZE = 60;
    vector<int> v(ARRAY_SIZE);
    
    // Генератор случайных чисел с фиксированным seed для воспроизводимости
    mt19937_64 gen;
    gen.seed(42);  // Фиксированный seed для одинаковых результатов при каждом запуске
    
    // Распределение Пуассона для генерации "интересных" значений
    // Среднее значение 4, что даёт числа в диапазоне ~35-50 после добавления 40
    poisson_distribution<> pd(4);
    
    cout << "Генерация тестового массива из " << ARRAY_SIZE << " элементов..." << endl;
    cout << "Значения: ";
    
    for(auto & item : v)
    {
        // Генерируем значение в диапазоне [40, 53]
        int value = 40 + pd(gen);
        item = value < 53 ? value : 53;  // Ограничиваем максимум для разумного времени вычислений
        cout << item << " ";
    }
    cout << "\n" << endl;
    
    // ------------------------------------------------------------------------
    // 2. Замер времени однопоточной версии (базовый уровень)
    // ------------------------------------------------------------------------
    
    cout << "Запуск однопоточной версии (базовый замер)..." << endl;
    auto st1 = chrono::high_resolution_clock::now();
    size_t nsingle = single(v);
    auto st2 = chrono::high_resolution_clock::now();
    
    // Переводим время в миллисекунды для удобства
    auto single_time = chrono::duration_cast<chrono::milliseconds>(st2 - st1).count();
    
    cout << "Однопоточное время: " << single_time << " мс" << endl;
    cout << "Результат (эталон): " << nsingle << " элементов с чётной суммой" << endl << endl;
    
    // ------------------------------------------------------------------------
    // 3. Подготовка списка тестируемых функций
    // ------------------------------------------------------------------------
    
    // Вектор функций для тестирования: имя + указатель на функцию
    vector<pair<string, function<size_t(const vector<int>&, size_t)>>> testFunctions = {
        {"block", block},                    // Блочное распределение (без синхронизации)
        {"mutex", this_is_the_way},          // Общий счётчик с mutex
        {"atomic", is_this_the_way}          // Атомарный счётчик
    };
    
    // Количество потоков для тестирования
    vector<size_t> threadCounts = {2, 3, 4};
    
    // ------------------------------------------------------------------------
    // 4. Основной цикл тестирования
    // ------------------------------------------------------------------------
    
    printHeader();
    
    // Сначала выводим результат однопоточной версии для сравнения
    TimingResult singleResult{1, single_time, nsingle, 1.0, 1.0};
    printResult("single", singleResult, 0);  // single_time=0 чтобы не пересчитывать speedup
    
    // Тестируем каждый подход с разным количеством потоков
    for(size_t n_threads : threadCounts)
    {
        cout << "\n--- Тестирование с " << n_threads << " потоками ---" << endl;
        
        for(const auto& [name, func] : testFunctions)
        {
            // Замеряем время выполнения
            auto t1 = chrono::high_resolution_clock::now();
            size_t result = func(v, n_threads);
            auto t2 = chrono::high_resolution_clock::now();
            
            auto exec_time = chrono::duration_cast<chrono::milliseconds>(t2 - t1).count();
            
            // Создаём структуру результата
            TimingResult tr{n_threads, exec_time, result, 0.0, 0.0};
            
            // Выводим результат с вычисленными метриками
            printResult(name, tr, single_time);
            
            // Проверка корректности: результат должен совпадать с однопоточным
            if(result != nsingle)
            {
                cerr << "⚠ WARNING: Результат не совпадает с эталоном!" << endl;
                cerr << "  Ожидалось: " << nsingle << ", получено: " << result << endl;
            }
        }
    }
    
    // ------------------------------------------------------------------------
    // 5. Вывод рекомендаций и анализа
    // ------------------------------------------------------------------------
    
    cout << "\n" << string(80, '=') << "\n";
    cout << "АНАЛИЗ РЕЗУЛЬТАТОВ:\n";
    cout << string(80, '=') << "\n";
    cout << "1. block: Лучшая производительность, т.к. нет конкуренции за ресурсы.\n";
    cout << "   Каждый поток пишет в свою ячейку памяти.\n\n";
    
    cout << "2. atomic: Хороший баланс между простотой и производительностью.\n";
    cout << "   Атомарные операции быстрее мьютексов для простых счётчиков,\n";
    cout << "   но могут создавать нагрузку на шину памяти при частых обновлениях.\n\n";
    
    cout << "3. mutex: Надёжный, но может быть медленнее из-за блокировок.\n";
    cout << "   Оптимизация с локальным счётчиком значительно улучшает производительность.\n";
    cout << "   Используйте, когда нужна сложная синхронизация нескольких ресурсов.\n\n";
    
    cout << "ФОРМУЛЫ:\n";
    cout << "  Speedup = T_single / T_parallel  (во сколько раз ускорились)\n";
    cout << "  Efficiency = Speedup / N_threads (насколько эффективно используем потоки)\n";
    cout << "  Идеальная эффективность = 1.0 (100% использование всех ядер)\n" << endl;
    
    return 0;
}
